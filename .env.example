# almost-agent 配置模板
#
# 用法：cp .env.example .env，只填下面「必填」区；其余项全部有默认值。
# .env 已被 .gitignore 忽略，不会入库。
#
# 设计约定（改动前请先看这里）：
# * 配置项的**唯一来源**是 src/ai_agent/core/config.py 的 Settings（全部字段）。
#   本文件不再重复抄写默认值——历史上抄了 134 份，已经有 6 处与代码漂移。
#   未在这里出现、也未在 .env 里设置的键，一律走 config.py 的默认值。
# * 下面除「必填」区外全是注释示例：需要覆盖时删掉行首 # 再填值。
# * .env 里出现 Settings 不认识的键，服务启动时会打 WARNING（不会拒绝启动）。
#   POSTGRES_PASSWORD 及部署/测试专用变量在白名单内。
# * 列出全部可配置键名：
#     uv run python -c "from ai_agent.core.config import Settings; print('\n'.join(sorted(k.upper() for k in Settings.model_fields)))"
#   默认值与说明直接看 config.py 同名字段上方的注释。

# ============ 必填（缺任一项启动即报错，共 9 项）============
# OpenAI 兼容网关：可指向官方、DashScope、Ollama、vLLM 等
BASE_URL=https://api.openai.com/v1
API_KEY=sk-替换为你的密钥
MODEL=gpt-4o-mini

# pgvector 连接串；本地开发用 docker compose up -d 起 pgvector/pgvector:pg17
DATABASE_URL=postgresql://root:替换密码@127.0.0.1:5432/ai_agent
# 不是 Settings 字段：docker-compose.yml 的 postgres 服务读它初始化，
# 必须与 DATABASE_URL 里的密码一致。
POSTGRES_PASSWORD=替换为数据库密码

EMBEDDING_MODEL=text-embedding-3-small
# 维度须与所选 embedding 模型一致
EMBEDDING_DIM=1536
MEMORY_TOP_K=5
MEMORY_SCORE_THRESHOLD=0.7
SHORT_TERM_MEMORY_MAX_TOKENS=4000

# ============ 常用可选覆盖（默认均为注释，取消注释才生效）============
# ---- 模型与网关 ----
# SMALL_MODEL=                       # 标题/摘要/记忆抽取/检索改写；留空跟随 MODEL
# LOCAL_BASE_URL=                    # 向量、整页 OCR、轻量任务的网关；留空跟随 BASE_URL
# LOCAL_API_KEY=                     # 留空跟随 API_KEY
# MEMORY_MODEL=                      # 留空跟随 SMALL_MODEL / MODEL
# KB_RERANK_BACKEND=                 # 默认 local_ce（需 uv add --group rerank FlagEmbedding），失败自动退回 llm
# KB_VISION_MODEL=                   # 留空=关闭图表视觉识别（按张计费，须显式开启）
# KB_OCR_MODEL=                      # 留空=关闭整页 OCR
#
# ---- 服务 ----
# HOST=                              # 默认 127.0.0.1
# PORT=                              # 默认 8000
# AUTH_TOKEN=                        # 非空时 /v1/** 要带 X-API-Key 或 Bearer；空=不校验
# CORS_ORIGINS=                      # 逗号分隔，默认 http://localhost:5173
# REGISTRATION_ENABLED=              # 默认 true；对外暴露前改 false
# MAX_CONCURRENT_CHATS=              # 默认 20
# DB_POOL_MAX_SIZE=                  # 默认 28，需 ≥ 聊天并发 + 各线程池之和
# ADMIN_USERNAMES=                   # 逗号分隔；空=无管理员，知识库写操作 403
# TRUST_FORWARDED_FOR=               # 默认 false；仅在可信反代后开 true
# REPORT_CONFIG_STRICT=              # 默认 false；预发布/CI 设 true，配置错直接拒绝启动
#
# ---- 密钥（默认空=对应功能关闭）----
# TAVILY_API_KEY=
# BOCHA_API_KEY=
# SERPER_API_KEY=
# JEV_API_KEY=                       # 记忆抽取门控；未配 key 时门控关闭、每轮直接抽取
#
# ---- 知识库 / 研报常用开关 ----
# KB_INGEST_INLINE=                  # 默认 false：API 只入队，由 ingest-worker 解析
# KB_GRAPH_ENABLED=                  # 默认 true
# ENABLE_CNINFO_FETCH=              # 默认 true；离线/CI 可设 false
# REPORT_DEEP_CHAPTER_CONCURRENCY=   # 默认 3（对外入口；库级 DeepConfig 仍为 1）
# REPORT_DEEP_REVIEW_ROUND_CONCURRENCY=  # 默认 0 = 该章所有轮次一起发
# REPORT_DEEP_CHAPTER_CHANNEL=       # 默认 primary；small = 小模型优先、空 content 升级

# ============ 几个容易踩坑的项（默认值不要照旧模板抄）============
# * JEV_BASE_URL / JEV_MODEL：代码默认走百炼 decision-model-preview，
#   JEV_BASE_URL 必须是**含路径的完整 endpoint**，gate.py 直接 POST 该地址，
#   不再在代码里拼 /v1/systemone。要切回官方 Jev，须同时显式设置：
#     JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
#     JEV_MODEL=jev-latest
#   只写域名根会让门控静默 fail-open（白跑一次调用，不报错）。
# * MEMORY_EXTRACT_JSON_MODE：代码默认 json_object（网关不支持会自动回退 off）。
#   旧模板写 off，与默认行为相反，不要照抄。
# * MEMORY_MERGE_TIMEOUT_SECONDS / SHORT_TERM_SUMMARY_TIMEOUT_SECONDS：代码默认 30 秒，
#   旧模板写 8 / 12，按需要显式覆盖即可。
# * KB_UPLOAD_DIR / KB_DOC_PROFILES_PATH：代码默认是**项目根下的绝对路径**。
#   填相对路径会按进程 cwd 解析，换目录启动就写到别处；一般不要覆盖。
# * MEMORY_EPISODE_TTL_SECONDS：默认 7 天（604800 秒）；0=永不过期。

# ============ 高级旋钮索引 ============
# 下面这些键都只在需要调参时显式设置；键名即 Settings 字段的大写形式，
# 默认值、取值范围与原因见 config.py 对应字段上方注释。

