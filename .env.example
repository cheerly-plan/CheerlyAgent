# almost-agent 配置模板
# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会入库。
# 字段对应 src/ai_agent/core/config.py 的 Settings；无默认值的为必填项。

# ============ LLM 网关（必填）============
# OpenAI 兼容接口的 base_url：可指向官方、DashScope、Ollama、vLLM 等
BASE_URL=https://api.openai.com/v1
API_KEY=sk-替换为你的密钥
# 主对话模型。重排、视觉、图谱走这套 BASE_URL / API_KEY
MODEL=gpt-4o-mini
# 轻量任务模型（标题、会话摘要、记忆抽取、检索改写）。
# 请求走 LOCAL_BASE_URL；未配本地地址时跟随 BASE_URL。空则跟随 MODEL 且走主网关。
SMALL_MODEL=
# 向量、整页 OCR，以及上面的轻量任务。空则跟随 BASE_URL / API_KEY。
# 对话走线上、嵌入和 OCR 走本机 Ollama 时才需要填。
LOCAL_BASE_URL=
LOCAL_API_KEY=
# 流式对话超时（秒）：LLM 卡死时占用并发槽与 SSE 线程的上限
LLM_STREAM_TIMEOUT_SECONDS=120
# 上下文 token 预算（0=不限）：Qwen tokenizer 计数，超过时整轮丢弃并入摘要
LLM_CONTEXT_TOKEN_BUDGET=28000
# 软水位（按扣掉输出预留后的可用预算比例）：达到后先收紧工具结果老化
CONTEXT_SOFT_LIMIT_RATIO=0.85
# 为本轮输出/工具参数预留的 token 数（实际输入预算 = 硬预算 - 预留）
CONTEXT_RESERVE_TOKENS=4000
# 工具 schema 的固定预留（摘要/缓存用；loop 按实际 step_tools 精确扣）
CONTEXT_TOOL_SCHEMA_RESERVE_TOKENS=5000
# Qwen tokenizer 文件；留空则用本地缓存/从镜像下载
QWEN_TOKENIZER_PATH=
QWEN_TOKENIZER_URL=https://hf-mirror.com/Qwen/Qwen3-8B/resolve/main/tokenizer.json
QWEN_TOKENIZER_TIMEOUT_SECONDS=30
# system 动态拼接块（画像/知识库能力/日期）的硬上限，超出按行裁剪
SYSTEM_DYNAMIC_MAX_CHARS=4000
# 最近 N 轮工具结果保留原文；更早的换元数据占位（0=只留当前轮，负数=关闭）
TOOL_RESULT_FULL_TURNS=2
# read_tool_result 的进程内结果池：LRU 条数 / TTL（秒） / 单条入池上限（字符）
TOOL_RESULT_POOL_MAX_ENTRIES=512
TOOL_RESULT_POOL_TTL_SECONDS=7200
TOOL_RESULT_POOL_MAX_CONTENT_CHARS=200000
# Agent 自主循环步数上限
MAX_TURNS=10
LOG_LEVEL=INFO

# ============ 服务 ============
HOST=127.0.0.1
PORT=8000
# 服务端访问令牌：非空时 /v1/** 要求携带 X-API-Key 或 Bearer Token；空=不校验
AUTH_TOKEN=
# 聊天流并发上限，超出返回 429
MAX_CONCURRENT_CHATS=20
# SSE 保活间隔（秒）：静默超过此时长发一个 `: keepalive` 注释帧，防止反代
# 在研报深度层十几分钟的长工具调用期间掐断连接；0=关闭
SSE_HEARTBEAT_SECONDS=15

# ============ 深度分析（研报）============
# 第 2-8 章并行度。7 章在 3 路下是 3+3+1 三波，4 路是 4+3 两波；
# 网关并发额度宽裕时调到 4-7 可再省约 1/3 墙钟时间，超出额度会 429。
REPORT_DEEP_CHAPTER_CONCURRENCY=3
# 单章评审轮次并行度：0=该章所有轮次一起发（默认，3 轮 → 3 路）；1=逐轮串行
# （网关并发额度紧张时回退）；其它正整数=线程池上限。
REPORT_DEEP_REVIEW_ROUND_CONCURRENCY=0
# 章节/评审模型通道：primary=直接主模型（默认）；small=小模型优先、空 content 升级
REPORT_DEEP_CHAPTER_CHANNEL=primary
# 数据库连接池上限，需 ≥ 聊天并发 + 标题线程池 + 收尾线程池之和
DB_POOL_MAX_SIZE=28
# 跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173
# 仅部署在可信反代之后才开启：开启后限流取 X-Forwarded-For 最右侧 IP
TRUST_FORWARDED_FOR=false
FORWARDED_ALLOW_IPS=127.0.0.1
# 开放注册：对外暴露前建议关闭（false），改为管理员建号
REGISTRATION_ENABLED=true
# 断点续跑模式：true=prefill 续写；false=整段重生成
RESUME_PREFILL=true

# ============ 数据库（必填）============
# pgvector 连接串；本地开发用 docker compose up -d 起 pgvector/pgvector:pg17
DATABASE_URL=postgresql://root:替换密码@127.0.0.1:5432/ai_agent
# docker-compose.yml 里 postgres 服务读这个密码
POSTGRES_PASSWORD=替换为数据库密码

# ============ 嵌入向量（必填）============
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度，须与所选 embedding 模型一致
EMBEDDING_DIM=1536

# ============ 记忆系统 ============
# 长期记忆召回条数（必填）
MEMORY_TOP_K=5
# 长期记忆相似度阈值（必填）
MEMORY_SCORE_THRESHOLD=0.7
MEMORY_MERGE_THRESHOLD=0.7
MEMORY_MERGE_TIMEOUT_SECONDS=8
# 记忆抽取/摘要用模型（空则跟随 SMALL_MODEL 或 MODEL）
MEMORY_MODEL=
# 情景记忆存活时间（秒）；0=永不过期
MEMORY_EPISODE_TTL_SECONDS=604800

# Jev 门控（System One 决策模型）：未配 key 时门控关闭，每轮直接抽取
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
MEMORY_GATE_THRESHOLD=0.65
JEV_TIMEOUT_SECONDS=4
# 长期记忆抽取是否要求模型输出 JSON：off=靠 prompt 约定+解析兜底（默认，任何
# 网关都能跑）；json_object=下发 response_format，网关不支持会自动回退。
MEMORY_EXTRACT_JSON_MODE=off

# 短期记忆（必填）
# 摘要输入（被挤出窗口的历史）的 token 预算，由 Qwen tokenizer 计数
SHORT_TERM_MEMORY_MAX_TOKENS=4000
SHORT_TERM_MEMORY_MAX_SESSIONS=1024
SHORT_TERM_MEMORY_TTL_SECONDS=3600
SHORT_TERM_MEMORY_CLEANUP_INTERVAL_SECONDS=300

TITLE_MODEL=
SHORT_TERM_SUMMARY_MODEL=
SHORT_TERM_SUMMARY_TIMEOUT_SECONDS=12
TITLE_TIMEOUT_SECONDS=20
SESSION_CLEANUP_INTERVAL_SECONDS=300
SESSION_EMPTY_MAX_AGE_SECONDS=3600

# ============ 联网搜索工具 ============
# 三个源都未配置时工具返回引导文案；优先级 tavily > bocha > serper
TAVILY_API_KEY=
BOCHA_API_KEY=
SERPER_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=15

# ============ 知识库管理员 ============
# 管理员用户名白名单（逗号分隔）：只有这些账号能上传/删除知识库文件；空=无管理员
ADMIN_USERNAMES=

# ============ 知识库（P1）============
KB_UPLOAD_DIR=data/uploads
KB_MAX_FILE_MB=100
KB_PART_SIZE_MB=4
# 巨潮定期报告补齐（默认开）：generate_report 发现缺本期/同比基期
# 原文会自动从巨潮拉取并入库，再继续抽数。管理端亦可
# POST /v1/kb/files/fetch-cninfo、/v1/kb/files/from-url。
# 仅内部研究场景；商业分发需自行确认授权。离线/CI 可设 false。
ENABLE_CNINFO_FETCH=true
CNINFO_REQUEST_INTERVAL_SECONDS=1.0
CNINFO_STOCK_CACHE_TTL_SECONDS=86400
# 全文 PDF 超过该体积（MB）改抓报告摘要；没有摘要仍下全文
CNINFO_FULL_MAX_MB=1
# 自动入库等待：基线秒数；实际 = min(CAP, max(基线, 每份×份数))
CNINFO_INGEST_WAIT_SECONDS=600
CNINFO_INGEST_WAIT_PER_FILE_SECONDS=90
CNINFO_INGEST_WAIT_CAP_SECONDS=1800
CNINFO_AUTO_FETCH_MAX=16
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
# 按章节切块
KB_SECTION_CHUNKING=true
# 单页栅栏：开启后同节内也强制按页断（溯源最精确但切断跨页内容）
KB_CHUNK_WITHIN_PAGE=false
# 表格切片力度：row=每个科目单独成片（细、自解释强但切片多）；
# section=语义感知滑动窗口（按 KB_CHUNK_SIZE 累积、在科目行边界断，
# 分组标题强制起新片），切片数大幅减少仍每片重复表头。默认 section（财报长表首选）
KB_TABLE_GROUP_MODE=section
# PDF 表格识别：表格抽成独立切片
KB_PDF_TABLE_EXTRACTION=true
# 嵌入批大小（DashScope 兼容接口单次 input 上限 10）
KB_EMBEDDING_BATCH=10
KB_EMBEDDING_CONCURRENCY=3
KB_PIPELINE_WORKERS=2
# 图谱构建独立线程数（须与 KB_PIPELINE_WORKERS 分池）
KB_GRAPH_WORKERS=1
# false：API 只入队，由 almost-agent ingest-worker 解析（推荐，隔离 OCR 崩溃）
# true：API 进程内 spawn 子进程解析（单进程/测试）
KB_INGEST_INLINE=false
KB_INGEST_POLL_SECONDS=1
# 单份解析子进程硬超时（秒），防止 OCR 挂死占满 worker 槽
KB_INGEST_JOB_TIMEOUT_SECONDS=1800
KB_SHEET_MAX_ROWS=2000

# ============ 图表识别（视觉模型）============
# 模型名为空即整体关闭（按张计费，须显式开启）
KB_VISION_MODEL=
KB_VISION_MAX_PAGES=20
KB_VISION_DPI=150
KB_VISION_CONCURRENCY=3
KB_VISION_VECTOR_PATHS=150
KB_VISION_TIMEOUT_SECONDS=90
KB_VISION_MAX_FAILURES=2
KB_VISION_MAX_TEXT_CHARS=600
KB_VISION_MIN_IMAGE_RATIO=0.06

# ============ 整页 OCR（Xiaomi-OCR-0 page 模式）============
# 模型名为空即关闭，PDF 仍走文字层 + 图表视觉。
# 填了之后 PDF 逐页渲染成图，用文档抽取提示词打到 LOCAL_BASE_URL
# （未配则 BASE_URL）上的该模型。
# 官方 MCP 只允许 127.0.0.1，这里不走 stdio MCP，局域网 Ollama 直接可用。
# 例：KB_OCR_MODEL=longwayxu/xiaomi-ocr-0:bf16
KB_OCR_MODEL=
# 0 = 不截断页数
KB_OCR_MAX_PAGES=0
KB_OCR_DPI=150
KB_OCR_MAX_EDGE=2048
KB_OCR_CONCURRENCY=2
KB_OCR_MAX_TOKENS=4096
KB_OCR_TIMEOUT_SECONDS=180
KB_OCR_MAX_FAILURES=2

# ============ 知识图谱（P2）============
KB_GRAPH_ENABLED=true
# 抽取专用模型/网关/key（空则跟随 MODEL/BASE_URL/API_KEY）
KB_GRAPH_MODEL=
KB_GRAPH_BASE_URL=
KB_GRAPH_API_KEY=
# 抽取温度：结构化输出必须取 0
KB_GRAPH_TEMPERATURE=0.0
KB_GRAPH_BATCH_CHUNKS=8
KB_GRAPH_FLUSH_BATCHES=15
KB_GRAPH_MIN_CHUNK_CHARS=40
KB_GRAPH_CONCURRENCY=3
KB_GRAPH_TIMEOUT_SECONDS=180
KB_GRAPH_MAX_NODES=200
KB_GRAPH_MIN_SCORE=0.55

# 抽取 prompt 的文档配置（通用底座 + 可插拔配置块，见 kb/doc_profiles.py）
KB_DOC_PROFILES_PATH=data/kb_doc_profiles.json
KB_DEFAULT_DOC_TYPE=general

# ============ 实体对齐 ============
KG_ALIGN_MIN_SIM=0.86
KG_ALIGN_NEIGHBORS=4
KG_ALIGN_BATCH=8
KG_ALIGN_MAX_PAIRS=240
KG_ALIGN_TIMEOUT_SECONDS=45
KG_ALIGN_MAX_CLUSTER=4

# ============ 检索质量 ============
KB_SEARCH_CANDIDATES=16
# 余弦距离上限（0 完全相同、2 完全相反）；设 2.0 等于关闭门槛
KB_SEARCH_MAX_DISTANCE=0.72
# 知识库文件描述：上传时维护，模型通过 kb_list_files 工具查看清单与描述来判断要查哪几份
# （不再把文件名预先注入对话上下文，也不再做首轮强制检索，由模型按需调用）
# LLM 重排
KB_RERANK_ENABLED=true
KB_RERANK_MODEL=
KB_RERANK_TEMPERATURE=0.0
KB_RERANK_TIMEOUT_SECONDS=30
# 重排后端：local_ce（本地 cross-encoder，默认，便宜且确定）/ llm（兜底）
# 用 local_ce 需先装依赖：uv add --group rerank FlagEmbedding，并首次拉取权重
KB_RERANK_BACKEND=local_ce
# 实体对齐是否要求模型输出 JSON（off / json_object），语义同上。
# 对齐结果会被直接拿去合并实体，猜错代价大，支持的话建议开。
KB_ALIGN_JSON_MODE=off
KB_NEIGHBOR_EXPAND=1
# 混合检索：关键词直查 + 向量召回做 RRF 融合
KB_HYBRID_ENABLED=true
KB_HYBRID_KEYWORDS=6
KB_HYBRID_CANDIDATES=12
# 主体配额带宽：某主体的最佳命中与全局最佳的余弦距离差在此之内，就保底
# 一个名额（「A 和 B 的营收」这类对比问句两家都出得来）。0 = 关掉配额。
KB_SUBJECT_QUOTA_BAND=0.12

# ============ 查询改写（多轮补全 + 检索增强）============
# 多轮对话改写：结合上一轮对话把当前追问补全/指代消解成自包含检索词
# （如「那它去年呢？」补全公司名）。关闭/无上文/失败一律退回原话。
# 默认关闭：对话模型已经看得到上文，调用检索工具时自己会带上主体。
KB_REWRITE_ENABLED=false
# 空 = 跟随 SMALL_MODEL，请求走本地网关。显式填了别的模型名则走主网关。
KB_REWRITE_MODEL=
KB_REWRITE_TIMEOUT_SECONDS=3.0
KB_REWRITE_HISTORY_TURNS=2
# 检索增强改写（multi-query）：把一条查询扩写成多条变体分别检索后 RRF 融合，
# 提升对比/口语长问句召回。默认关闭——开启会显著增加检索次数与延迟，
# 请先用评测验证效果与延迟可接受再设为 true。
KB_MULTIQUERY_ENABLED=false
KB_MULTIQUERY_MODEL=
KB_MULTIQUERY_COUNT=3
KB_MULTIQUERY_TIMEOUT_SECONDS=3.0

# ============ 文档摘要 + 文档路由 ============
# 每份文件入库后额外生成一段摘要并单独 embedding，检索前先按它选出候选
# 文档：模型不必再对着文件清单挑 files，文件数也不再进提示词
KB_SUMMARY_ENABLED=true
KB_SUMMARY_MAX_CHARS=1200
KB_SUMMARY_HEAD_CHUNKS=8
KB_SUMMARY_HEAD_CHARS=160
KB_SUMMARY_ENTITIES=12
# 没填 files 时按摘要向量自动路由；关掉则退回会话范围 / 全库
KB_DOC_ROUTE_ENABLED=true
# 一次路由选出的文档数上限（点名的文件优先且不受此限以外的顺序影响）
KB_DOC_ROUTE_TOP_K=6
# 摘要向量距离上限：超线的文件连候选都不进。文档级摘要比切片更「泛」，
# 这个门槛要比 KB_SEARCH_MAX_DISTANCE 更严，否则路由等于没做
KB_DOC_ROUTE_MAX_DISTANCE=0.55

# ============ 研报配置 lint ============
# 启动时校验 indicators.yaml / sections.yaml / 降级镜像 / SKILL.md 绑定。
# 默认 false：配置有错只记 ERROR 日志并走降级路径，不让一份 YAML 拼错拖垮全站。
# 预发布与 CI 设 true（或直接跑 uv run python scripts/lint_report_config.py 硬门禁）。
REPORT_CONFIG_STRICT=false
