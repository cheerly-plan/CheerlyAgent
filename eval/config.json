{
  "version": 2,
  "enabled_tiers": [
    0,
    1,
    2
  ],
  "base_env": [
    "BASE_URL",
    "API_KEY",
    "MODEL",
    "DATABASE_URL",
    "EMBEDDING_MODEL"
  ],
  "thresholds": {
    "eval_retrieval": 0.85,
    "eval_memory": 0.8,
    "eval_tool_route": 0.8,
    "memory_health": 0.8
  },
  "timeouts_s": {
    "pytest_eval_selftest": 120,
    "ruff_eval_scripts": 60,
    "eval_retrieval": 300,
    "eval_graph_retrieval_validate": 180,
    "eval_graph": 180,
    "eval_tool_route": 600,
    "eval_memory": 600,
    "memory_health": 120
  },
  "diff": {
    "metric_tolerance": 0.05,
    "metric_keys": [
      "pass_rate"
    ],
    "block_on_new_failures": true,
    "block_on_invalid_cases": true,
    "block_on_env_error": true
  },
  "suites": [
    {
      "name": "eval_retrieval",
      "tier": 1,
      "command": "uv run python scripts/eval_retrieval.py",
      "exit_map": {
        "0": "pass",
        "1": "regression",
        "2": "invalid_cases"
      },
      "policy": "blocking",
      "note": "默认关重排测纯检索质量；通过线见 thresholds；退出码 2 = 用例与语料对不上（main 里 validate_cases 前置）"
    },
    {
      "name": "eval_graph_retrieval_validate",
      "tier": 1,
      "command": "uv run python scripts/eval_graph_retrieval.py --validate",
      "exit_map": {
        "0": "pass",
        "1": "invalid_cases"
      },
      "policy": "blocking",
      "note": "全量评测 main() 恒返回 0、无质量语义，故只跑 --validate 做用例有效性门禁；质量指标待解析 --out 明细后接入"
    },
    {
      "name": "eval_graph",
      "tier": 1,
      "command": "uv run python scripts/eval_graph.py",
      "exit_map": {
        "0": "pass",
        "1": "env_error"
      },
      "policy": "informational",
      "note": "退出码 1 = 找不到文件或图谱为空；脚本没有通过线，只挡环境数据缺失，指标仅记录不阻断"
    },
    {
      "name": "eval_tool_route",
      "tier": 2,
      "command": "uv run python scripts/eval_tool_route.py",
      "exit_map": {
        "0": "pass",
        "1": "advisory_fail",
        "2": "env_error"
      },
      "policy": "advisory",
      "note": "要调模型、结果有抖动，失败只记趋势不阻断发布；通过线见 thresholds"
    },
    {
      "name": "eval_memory_rules",
      "tier": 1,
      "command": "uv run python scripts/eval_memory_rules.py",
      "exit_map": {
        "0": "pass",
        "1": "regression",
        "2": "invalid_cases"
      },
      "policy": "blocking",
      "note": "记忆规则层离线评测：不调模型、不连库，量化「该记未记」与「不该记记了」；退出码 1 = 低于 --min-remember/--min-forget 通过线"
    },
    {
      "name": "eval_memory_rules_crossdomain",
      "tier": 1,
      "command": "uv run python scripts/eval_memory_rules.py --cases cases/memory_crossdomain_cases.json --min-forget 0.75",
      "exit_map": {
        "0": "pass",
        "1": "regression",
        "2": "invalid_cases"
      },
      "policy": "blocking",
      "note": "跨领域（医疗/法律/教育/客服）规则评测：防止规则过拟合到金融+技术场景；open 类问句归 model 不计分"
    },
    {
      "name": "eval_memory_rules_realworld",
      "tier": 1,
      "command": "uv run python scripts/eval_memory_rules.py --cases cases/memory_realworld_cases.json --min-forget 0.5 --min-remember 0.95",
      "exit_map": {
        "0": "pass",
        "1": "regression",
        "2": "invalid_cases"
      },
      "policy": "blocking",
      "note": "真实对话用例（来自线上 170 条用户消息中的自述片段）：覆盖混合意图、撤回指令、意向 vs 事实等自造用例缺失的分布"
    },
    {
      "name": "eval_memory",
      "tier": 2,
      "command": "uv run python scripts/eval_memory.py",
      "exit_map": {
        "0": "pass",
        "1": "regression",
        "2": "env_error"
      },
      "policy": "blocking",
      "note": "抽取会调模型，只在 nightly / 显式 --allow-external 时跑。通过率跌破 thresholds 会阻断发布；刻意不跑 --recall（会写库）"
    },
    {
      "name": "multiturn_compress",
      "tier": 1,
      "command": "uv run python scripts/eval_multiturn_compress.py --keep-last 1 --min-rate 0.95",
      "exit_map": {
        "0": "pass",
        "1": "regression",
        "2": "invalid_cases"
      },
      "policy": "blocking",
      "note": "多轮压缩：确定性摘要下追问事实必须无损（不调模型）；LLM 摘要模式用 --summarize llm 本地跑"
    },
    {
      "name": "memory_health",
      "tier": 1,
      "command": "uv run python scripts/eval_memory_health.py",
      "exit_map": {
        "0": "pass",
        "1": "regression",
        "2": "invalid_cases"
      },
      "policy": "blocking",
      "note": "纯本地：噪声拦截率 / 召回 Recall+MRR / 排序健康度；不连库、不调模型，CI 可稳定跑"
    }
  ]
}
